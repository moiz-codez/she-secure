rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every document this app writes lives under users/{uid}/... — a
    // signed-in user may only ever read or write their own subtree.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
